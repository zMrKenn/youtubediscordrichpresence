# Everything here is OPTIONAL. The app runs fine with no .env at all - the Discord
# app id is baked into the binary. Only add a value to override the default.

# DISCORD_APP_ID=your_own_app_id   # use your own Discord application
# BRIDGE_PORT=41414                # must match the extension
# ACTIVITY_TYPE=2                  # 2 = Listening, 3 = Watching, 0 = Playing
# SMALL_ICON_URL=                  # small corner badge (public image URL)
